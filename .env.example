# Database
DATABASE_URL=postgresql+asyncpg://swissedge:swissedge@localhost:5432/swissedge

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI Provider (openai | anthropic)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# W2 — Gated live AI (Dani-approved activation, 2026-06-11).
# AI_LIVE_ENABLED=false keeps every provider call blocked with a controlled 503.
# Flip to true ONLY together with a budget. Rollback = set false again.
AI_LIVE_ENABLED=true
AI_DAILY_BUDGET_USD=5
# Stronger model for long-document analysis tasks; default stays gpt-4o-mini.
AI_TASK_MODEL_OVERRIDES={"analyze_case_preview": "gpt-4o", "brief_preview": "gpt-4o"}
# W1 — automatic SEC document acquisition off-switch (default true).
AUTO_ACQUIRE_DOCUMENTS=true

# SEC EDGAR — required by their API, use your real email
SEC_USER_AGENT=SwissEdge/1.0 (kangrenilla@gmail.com)

# App
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
